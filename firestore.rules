rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. PUBLIC READ-ONLY CONTENT (CATALOGUE & MARKETING)
    // Products, Categories, Solutions, Projects, Articles, Team, Site Config, Media, Keypoints
    // ==========================================
    match /products/{document=**} {
      allow read: if true;
      allow write: if true; // Managed via Aveon Admin Panel
    }

    match /categories/{document=**} {
      allow read: if true;
      allow write: if true; // Managed via Aveon Admin Panel
    }

    match /solutions/{document=**} {
      allow read: if true;
      allow write: if true; // Managed via Aveon Admin Panel
    }

    match /projects/{document=**} {
      allow read: if true;
      allow write: if true; // Managed via Aveon Admin Panel
    }

    match /articles/{document=**} {
      allow read: if true;
      allow write: if true; // Managed via Aveon Admin Panel
    }

    match /team/{document=**} {
      allow read: if true;
      allow write: if true; // Managed via Aveon Admin Panel
    }

    match /keypoints/{document=**} {
      allow read: if true;
      allow write: if true; // Managed via Aveon Admin Panel
    }

    match /site_config/{document=**} {
      allow read: if true;
      allow write: if true; // Managed via Aveon Admin Panel
    }

    match /media/{document=**} {
      allow read: if true;
      allow write: if true; // Managed via Aveon Admin Panel
    }

    match /testimonials/{document=**} {
      allow read: if true;
      // Allow users/guests to submit testimonials, and admin to manage
      allow create: if true;
      allow update, delete: if true;
    }

    // ==========================================
    // 2. USER PROFILES & PRIVATE CARTS
    // Restricted strictly to the authenticated owner
    // ==========================================
    match /users/{userId} {
      // User can only view & update their own profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /carts/{userId} {
      // User can only view & sync their own cart
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================
    // 3. PRODUCT REVIEWS
    // Anyone can read reviews; logged-in users or admins can submit/manage
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if true;
    }

    // ==========================================
    // 4. ORDERS & ENQUIRIES (Checkout, Quote Requests, Contact)
    // Allows guest checkout, order tracking by orderRef/email, and admin order management
    // ==========================================
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // ==========================================
    // 5. NEWSLETTER SUBSCRIPTIONS
    // Anyone can subscribe via email in the footer; admin can view & manage
    // ==========================================
    match /newsletter_subscriptions/{subscriptionId} {
      allow create: if true;
      allow read, delete: if true;
    }

  }
}
